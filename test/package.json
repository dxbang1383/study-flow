{
  "name": "study-flow-tests",
  "version": "1.0.0",
  "description": "Standalone testing suite for Study Flow",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run unit/ --coverage",
    "test:integration": "vitest run integration/ --coverage",
    "test:e2e": "playwright test e2e/",
    "test:non-functional": "playwright test non-functional/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:non-functional"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "^2.1.8",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.14.2",
    "lucide-react": "^0.487.0",
    "zustand": "^5.0.12",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0",
    "class-variance-authority": "^0.7.1",
    "@radix-ui/react-slot": "^1.1.2"
  }
}
